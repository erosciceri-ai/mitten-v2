{
  "name": "@mitten/esp32-simulator",
  "version": "1.0.0",
  "description": "ESP32 simulator for MITTEN V2 (stdin/stdout NDJSON protocol)",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/simulator.js",
    "dev": "ts-node src/simulator.ts"
  },
  "dependencies": {
    "@mitten/contracts": "file:../../packages/contracts"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^4.1.11",
    "@types/node": "^26.6.4"
  }
}
