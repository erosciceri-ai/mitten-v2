# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Compiled TypeScript output inside source trees must never be tracked.
# Note: "src/*.js" does NOT match nested paths such as "src/db/index.js";
# the "**/" prefix is required.
**/src/**/*.js
**/src/**/*.d.ts
**/src/**/*.js.map
**/src/**/*.d.ts.map
**/src/**/*.tsbuildinfo
!apps/web/src/global.d.ts

# Environment files (keep the secret-free template tracked)
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Database
*.db
*.sqlite
data/

# Turbo
.turbo/
# Python caches and board-specific wiring
__pycache__/
*.py[cod]
.pytest_cache/
firmware/esp32/hardware_config.py
# Firmware runtime data
firmware/esp32/gestures.json
firmware/esp32/gestures.staging

# Accidental Windows files
nul
**/nul

# Local generic agent skills
.agents/skills/banner-design/
.agents/skills/brand/
.agents/skills/design-system/
.agents/skills/design/
.agents/skills/slides/
.agents/skills/ui-styling/
.agents/skills/ui-ux-pro-max/

# Local design-tool state and generated reports
/.impeccable/
/apps/web/.impeccable/
