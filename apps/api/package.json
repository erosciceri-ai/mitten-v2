{
  "name": "@mitten/api",
  "version": "0.1.0",
  "description": "MITTEN V2 backend API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@mitten/contracts": "file:../../packages/contracts",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-validator": "^7.1.0",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.4",
    "@types/sqlite3": "^3.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
