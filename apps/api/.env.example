# MITTEN V2 Backend API Environment Variables

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# IPs/CIDRs of the authorized HTTPS reverse proxy; leave empty for direct local access.
TRUSTED_PROXY=

# Database
DB_PROVIDER=sqlite
DB_PATH=./data/mitten.db
# PostgreSQL uses verified TLS. Supply the URL through the environment.
DATABASE_URL=
DB_TLS=verify-full
DB_POOL_MAX=5

# JWT
JWT_SECRET=
# Generate at least 32 random bytes and store the encoded value outside the repository.
# Expiration accepts seconds or s/m/h/d/w units (60 seconds to 30 days).
JWT_EXPIRES_IN=7d

# Sign in with Google (same Web Client ID used by apps/web).
GOOGLE_CLIENT_ID=

# mock intentionally reports audio unavailable; it never fabricates an MP3.
AUDIO_DIR=./data/audio
TTS_PROVIDER=mock
# Local Piper provider (run `npm run tts:setup`; use absolute paths on Windows).
# PIPER_EXECUTABLE=C:\path\to\v2\.runtime\tts\.venv\Scripts\python.exe
# PIPER_MODEL=C:\path\to\v2\.runtime\tts\voices\es_AR-daniela-high.onnx
PIPER_TIMEOUT_MS=60000
# Optional existing ElevenLabs provider:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Audio object storage (local works without credentials)
AUDIO_STORAGE_PROVIDER=local
AUDIO_S3_ENDPOINT=
AUDIO_S3_REGION=
AUDIO_S3_BUCKET=
AUDIO_S3_ACCESS_KEY_ID=
AUDIO_S3_SECRET_ACCESS_KEY=
