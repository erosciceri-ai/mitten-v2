# MITTEN V2 Backend API Environment Variables

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DB_PATH=./data/mitten.db

# JWT
JWT_SECRET=
# Set a randomly generated secret of at least 32 characters.
JWT_EXPIRES_IN=7d

# Sign in with Google (same Web Client ID used by apps/web).
GOOGLE_CLIENT_ID=

# mock intentionally reports audio unavailable; it never fabricates an MP3.
AUDIO_DIR=./data/audio
TTS_PROVIDER=mock
# Local Piper provider (run `npm run tts:setup`; use absolute paths on Windows).
# PIPER_EXECUTABLE=C:\path\to\v2\.runtime\tts\.venv\Scripts\python.exe
# PIPER_MODEL=C:\path\to\v2\.runtime\tts\voices\es_AR-daniela-high.onnx
PIPER_TIMEOUT_MS=60000
# Optional existing ElevenLabs provider:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
