# MITTEN V2 Backend API Environment Variables

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DB_PATH=./data/mitten.db

# JWT
JWT_SECRET=
# Set a randomly generated secret of at least 32 characters.
JWT_EXPIRES_IN=7d

# mock intentionally reports audio unavailable; it never fabricates an MP3.
AUDIO_DIR=./data/audio
TTS_PROVIDER=mock
# Optional existing ElevenLabs provider:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
