{
  "name": "@mitten/contracts",
  "version": "1.0.0",
  "description": "Shared contracts for MITTEN V2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "require": "./dist/protocol.js",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.cjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "mitten",
    "contracts",
    "protocol"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "dependencies": {}
}
