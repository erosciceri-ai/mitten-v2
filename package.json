{
  "name": "mitten-v2",
  "version": "2.1.0",
  "description": "MITTEN V2 — Guante electrónico para traducir gestos de mano a audio hablado",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "tts:setup": "node tools/setup-local-tts.mjs",
    "tts:smoke": "node --import tsx tools/smoke-local-tts.mjs",
    "test": "node --test tools/dev-ports.test.mjs && npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@mitten/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "simulator": "npm run start --workspace=tools/esp32-simulator"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
